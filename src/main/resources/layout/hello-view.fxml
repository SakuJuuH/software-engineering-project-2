<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="413.0" prefWidth="200.0" spacing="10.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
      <Label fx:id="lblAuthor" text="Author: Saku Heinonen" />
        <Label fx:id="lblDistance" text="Distance" />
        <TextField fx:id="txtDistance" />
        <Label fx:id="lblFuel" text="Fuel" />
        <TextField fx:id="txtFuel" />
        <Button fx:id="btnCalculate" onAction="#onCalculateClick" text="Calculate" />
        <Label fx:id="lblResult" />
        <Button onAction="#onENClick" text="EN!" />
        <Button onAction="#onFRClick" text="FR!" />
        <Button onAction="#onJPClick" text="JP!" />
        <Button onAction="#onIRClick" text="IR!" />
    </children>
</VBox>
